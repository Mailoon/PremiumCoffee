# ==========================================================================
# PremiumCoffe — plantilla de variables de entorno
#
#   1. cp .env.example .env    (o en Windows: copy .env.example .env)
#   2. Rellena los valores
#   3. docker compose up --build
#
# Este archivo SI se sube a git. El .env NO. Nunca pongas credenciales aqui.
# ==========================================================================


# --------------------------------------------------------------------------
# Base de datos — Supabase (obligatorias)
#
# OJO con el pooler, no con el host directo:
#
#   db.<ref>.supabase.co              -> solo IPv6, NO conecta desde Docker/Windows
#   aws-0-us-east-2.pooler.supabase.com -> SI conecta, usuario postgres.<ref>
#
# Si cambias de region, cambia tambien el prefijo del pooler (aws-0-... por
# ejemplo en us-east-2). El usuario lleva el project ref con punto, no guion.
#
# Para el servicio "migrate" de docker-compose.yml esta misma URL se pasa
# tal cual, asi que el formato jdbc:postgresql:// es el que espera.
# --------------------------------------------------------------------------
DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=

# Conexiones maximas del pool de Hikari POR CONTENEDOR.
# Multiplicar por el numero de replicas para saber el total contra Supabase.
# Con 5 replicas y 10 esto son 50 conexiones. Sube solo si el pooler aguanta.
DB_POOL_SIZE=10


# --------------------------------------------------------------------------
# Cloudinary (opcionales)
#
# Con CLOUDINARY_ENABLED=false el backend arranca igual usando
# DisabledMediaStorage, y las llamadas de media responden 503.
# Ponlo en true cuando quieras subir archivos de verdad.
#
# OJO: solo acepta true o false. NO escribas 1, 0, yes, si, on...
# Spring decide el bean con havingValue, asi que un valorraro deja al
# contenedor sin ningun bean MediaStorage y el arranque falla con un error
# que no dice nada de Cloudinary. Con false, el backend SIEMPRE arranca.
# --------------------------------------------------------------------------
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=premiumcoffee


# --------------------------------------------------------------------------
# Media local (opcionales)
# --------------------------------------------------------------------------
# Con MEDIA_LOCAL_ENABLED=true el backend deja de subir a Cloudinary y escribe
# los archivos en MEDIA_LOCAL_ROOT, con la ruta derivada del SHA-256 del
# contenido:  sha256/<2 primeros>/<hash>.<extension>
#
# El hash ES la invalidacion de cache. El mismo archivo subido dos veces da la
# misma URL, asi que el navegador no lo vuelve a descargar. Un contenido
# distinto da una URL distinta. No hay que invalidar nada a mano.
#
# La extension sale de los primeros bytes del archivo, nunca del nombre que
# manda el cliente, asi que la ruta no puede escapar de este directorio.
#
# OJO: el backend solo ESCRIBE aqui. Caddy LEE el mismo volumen y sirve los
# archivos con file_server (docker-compose.yml monta `media` en rw para backend
# y en ro para caddy). Por eso un .glb de 30 MB no pasa nunca por la JVM.
#
# MEDIA_LOCAL_PUBLIC_PATH es la ruta por la que Caddy publica el directorio.
# Si la cambias aqui, cambiala tambien en el `handle /media/*` del Caddyfile.
MEDIA_LOCAL_ENABLED=false
MEDIA_LOCAL_ROOT=/srv/media
MEDIA_LOCAL_PUBLIC_PATH=/media


# --------------------------------------------------------------------------
# Frontend / proxy
# --------------------------------------------------------------------------
# Puerto del host para Nuxt. Cambialo si el 3000 esta ocupado.
FRONTEND_PORT=3000

# URL INTERNA del backend Kotlin, vista solo desde el servidor de Nuxt.
#
# NO hace falta definirla en desarrollo. Nuxt ya trae el default
# "http://backend:8080" en runtimeConfig.apiBase (Frontend/nuxt.config.ts), que
# es el nombre del servicio dentro de la red de Docker Compose.
#
# En PRODUCCION si es obligatoria, y se pasa como NUXT_API_BASE en
# docker-compose.yml, apuntando a la URL interna de la nube (no la pública).
# Se lee en TIEMPO DE EJECUCION, asi que la imagen no se reconstruye.
#
# NUNCA se expone al navegador: va en runtimeConfig privado, no en public.

# URL PUBLICA del sitio. Esta si viaja al navegador: la usan los SEO,
# las URLs de imagen y las etiquetas Open Graph.
SITE_PUBLIC_URL=http://localhost:3000

# --------------------------------------------------------------------------
# CSRF (B3)
# --------------------------------------------------------------------------
# El sitio sirve por HTTPS cuando Caddy esta delante (perfil "tls").
#
# CSRF_COOKIE_SECURE=true hace que la cookie del secreto CSRF solo viaje
# por HTTPS. Es lo correcto en produccion, pero NO en el perfil local de
# produccion de docker-compose, que sirve el sitio por http en el puerto
# 3000: con Secure, el navegador rechaza la cookie y todas las peticiones
# que cambien estado fallan con 403.
#
# CSRF_COOKIE_KEY=__Host-csrf activa el prefijo que el navegador solo
# acepta si la cookie es Secure, va en Path=/ y no lleva Domain. Solo tiene
# sentido junto con CSRF_COOKIE_SECURE=true.
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_KEY=csrf

# --------------------------------------------------------------------------
# Caddy (solo se usa con: docker compose --profile tls up)
# --------------------------------------------------------------------------
# Puertos en el host para el ensayo de TLS. El 443 real choca con el
# administrador de Docker Desktop, de ahi el 8443.
CADDY_HTTPS_PORT=8443
CADDY_HTTP_PORT=8081

# En PRODUCCION esto pasa a ser el dominio real, y Caddy pide el
# certificado a Let's Encrypt solo. Ademas, en docker-compose.yml hay que
# descomentar NUXT_API_BASE apuntando al backend interno de la nube.
#   SITE_PUBLIC_URL=https://tu-dominio.com
#   CADDY_HTTPS_PORT=443
#   CADDY_HTTP_PORT=80


# --------------------------------------------------------------------------
# Supabase Auth (F2.7)
# --------------------------------------------------------------------------
# El backend es el unico que habla con Supabase Auth. El navegador NUNCA lo
# hace: la CSP del frontend solo permite connect-src 'self', y el proxy de
# origen unico (Nitro) es quien reenvia la peticion al backend.
#
# SUPABASE_URL      -> https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY -> la clave PUBLICABLE (empieza por "eyJ..."). Esta la
#                      puede usar cualquiera que tenga la URL del proyecto,
#                      asi que puede ir en el backend. Lo que NO va nunca en
#                      ningun archivo de este repositorio es la clave secreta
#                      (sb_secret_... / service_role).
#
# Si se dejan vacias, el backend arranca igual: la autenticacion queda
# desactivada hasta que se rellenen.
SUPABASE_URL=
SUPABASE_ANON_KEY=


# --------------------------------------------------------------------------
# Puertos y subidas
# --------------------------------------------------------------------------
# Limite por archivo del endpoint /media-assets/upload.
# OJO: es global, asi que tambien aplica a los .glb del visor 3D.
MAX_UPLOAD_SIZE=10MB
#
# OJO: ya NO existe BACKEND_PORT. El backend no se publica en el host
# (F0.1): su unico camino de entrada es el proxy de origen unico
# Caddy -> Nitro -> Kotlin. Publicar el 8080 dejaba una puerta directa al
# backend, por detras del proxy.


# --------------------------------------------------------------------------
# PENDIENTE — cuando exista el frontend
# --------------------------------------------------------------------------
# URL publica del backend, tal como la ve el navegador. Lo usara el proxy
# Caddy para saber a donde enviar /api.
# API_PUBLIC_URL=https://api.tudominio.com

# FRONTEND_PORT=3000