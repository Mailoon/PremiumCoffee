# ==========================================================================
# Plantilla del .env.local de Nuxt.
#
# Copiala a ".env.local" (sin el .example) para trabajar SIN Docker:
#
#   Backend  ->  .\gradlew.bat bootRun   (desde IntelliJ o la terminal)
#   Frontend ->  npm run dev
#
# ==========================================================================

# --------------------------------------------------------------------------
# Por que esto NO esta en nuxt.config.ts
#
# El default de runtimeConfig.apiBase es "http://backend:8080", que es el
# nombre del servicio en la red de Docker Compose. Funciona cuando TODO corre
# en contenedores.
#
# Si cambias el default a "http://localhost:8080" para usarlo con npm run dev,
# rompes Docker: DENTRO de un contenedor, "localhost" es el propio contenedor
# Nuxt, no tu maquina. Spring Boot esta en otro contenedor, asi que el proxy
# devolveria 502 sin encontrar nada.
#
# Por eso se resuelve con un archivo en vez de tocar el codigo. Nuxt lee estas
# variables en cascada y gana la mas especifica:
#
#   runtimeConfig (nuxt.config.ts)  ->  .env  ->  .env.local  ->  contenedor
#
# Este archivo SOLO aplica a npm run dev. En Docker manda lo que pase por
# variable de entorno, asi que la imagen sigue sirviendo para dev, staging y
# produccion.
# --------------------------------------------------------------------------

NUXT_API_BASE=http://localhost:8080

# URL publica del sitio. Esta si viaja al navegador.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------------
# OJO: esto NO lleva el prefijo NUXT_.
#
# Lo que no empieza por NUXT_ se queda en el servidor y NO llega al
# navegador. Ejemplo de lo que podrias anadir aqui el dia que haya
# autenticacion, para que el frontend nunca vea un secreto:
#
#   DB_PASSWORD=...
#   JWT_SECRET=...
#
# Lo que si lleva NUXT_PUBLIC_ si viaja al bundle del cliente, asi que nunca
# pongas ahi una contrasena ni una API key.
# --------------------------------------------------------------------------